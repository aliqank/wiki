    <bpmn:textAnnotation id="TextAnnotation_02buv82">
      <bpmn:text>При невозможности предоставить конкретную технику в конкретный диапазон времени Fleet Owner должен рассмотреть возможность заменить технику и/или период брони</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_067ks78" associationDirection="None" sourceRef="Activity_1xzp726" targetRef="TextAnnotation_02buv82" />
