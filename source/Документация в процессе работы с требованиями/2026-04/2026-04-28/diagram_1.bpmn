    <bpmn:textAnnotation id="TextAnnotation_05gqsni">
      <bpmn:text>Список техники должен содержать фильтры по типам техники и по специфическим характеристикам техники</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_10e4qj6">
      <bpmn:text>При выборе указать диапазон времени</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1w3m2dc">
      <bpmn:text>Для каждой техники своего флита подтвердить бронь</bpmn:text>
    </bpmn:textAnnotation>
